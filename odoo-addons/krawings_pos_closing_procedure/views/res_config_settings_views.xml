<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.krawings_pos_closing_procedure</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_manager_email" string="POS Manager Email" help="Manager email that the daily sales report is sent to.">
                    <field name="manager_email_address"/>
                </setting>
            </xpath>

        </field>
    </record>
</odoo>